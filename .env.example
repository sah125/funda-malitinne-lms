# ═════════════════════════════════════════════════════════════
# Funda Malitinne LMS - Environment Configuration Template (.env.example)
# ═════════════════════════════════════════════════════════════
#
# INSTRUCTIONS:
# 1. Copy this file to .env in the project root
# 2. Fill in your values (especially for production)
# 3. NEVER commit .env to version control
# 4. For local dev, you can leave most values as-is (defaults are dev-safe)
#

# ═════════════════════════════════════════════════════════════
# DJANGO CORE
# ═════════════════════════════════════════════════════════════

# Generate a fresh SECRET_KEY with:
# python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=your-secret-key-here

# Development: leave False or unset
# Production: always False unless you know what you're doing
DEBUG=False

# Space-separated list of allowed hosts (for local dev, these are defaults)
ALLOWED_HOSTS=localhost 127.0.0.1

# ═════════════════════════════════════════════════════════════
# DATABASE
# ═════════════════════════════════════════════════════════════

# For local dev: leave unset (defaults to SQLite) or set to 'sqlite3'
# For production: set to 'postgresql'
DB_ENGINE=sqlite3

# Only needed if DB_ENGINE=postgresql:
DB_NAME=funda_malitinne_lms
DB_USER=postgres
DB_PASSWORD=secure-password-here
DB_HOST=localhost
DB_PORT=5432

# ═════════════════════════════════════════════════════════════
# EMAIL (SMTP)
# ═════════════════════════════════════════════════════════════

# For local dev: leave unset (defaults to console backend - prints to terminal)
# For production: set to 'django.core.mail.backends.smtp.EmailBackend'
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend

EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True

# For SMTP (only needed if EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend):
EMAIL_HOST_USER=your-email@gmail.com
EMAIL_HOST_PASSWORD=your-app-specific-password

DEFAULT_FROM_EMAIL=noreply@malitinne.local

# ═════════════════════════════════════════════════════════════
# CACHE & MESSAGE BROKER (Redis)
# ═════════════════════════════════════════════════════════════

CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# For development: leave as True (tasks run immediately)
# For production: set to False and ensure Redis is running
CELERY_TASK_ALWAYS_EAGER=True

# ═════════════════════════════════════════════════════════════
# CORS (Cross-Origin Resource Sharing)
# ═════════════════════════════════════════════════════════════

# Space-separated list of allowed origins
# Local dev: http://localhost:3000 http://127.0.0.1:3000
# Production: https://malitinne.co.za https://www.malitinne.co.za
CORS_ALLOWED_ORIGINS=http://localhost:3000 http://127.0.0.1:3000

# ═════════════════════════════════════════════════════════════
# SECURITY (Production Only)
# ═════════════════════════════════════════════════════════════

# Only set these to True in production behind HTTPS:
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False

# HSTS (HTTP Strict Transport Security)
# Start with 60 seconds to test, then increase to 31536000 (1 year)
SECURE_HSTS_SECONDS=0

# CSRF trusted origins (space-separated)
CSRF_TRUSTED_ORIGINS=http://localhost:8000 http://127.0.0.1:8000

# ═════════════════════════════════════════════════════════════
# APPLICATION SETTINGS
# ═════════════════════════════════════════════════════════════

TIME_ZONE=Africa/Johannesburg
LANGUAGE_CODE=en-us

# ═════════════════════════════════════════════════════════════
# IMPORTANT SECURITY NOTES
# ═════════════════════════════════════════════════════════════
#
# ⚠️ CRITICAL: If you previously committed lms/settings.py with real secrets:
#
# 1. IMMEDIATELY rotate these passwords:
#    - Database password (DB_PASSWORD)
#    - Gmail app password (EMAIL_HOST_PASSWORD)
#    - Any API keys
#
# 2. Check if secrets are in git history:
#    git log -p -- lms/settings.py | grep -i password
#
# 3. If secrets are in history, scrub them:
#    Option A (easy): git filter-repo --path lms/settings.py
#    Option B (thorough): BFG repo-cleaner: https://rtyley.github.io/bfg-repo-cleaner/
#
# 4. Ensure .env and settings.py (with real values) are in .gitignore
#
# 5. Force-push the cleaned history (if it's a shared repo, coordinate with team)
#    git push --force-with-lease
LOG_LEVEL=INFO
